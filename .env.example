# Modelo de configuração do PingHub.
# Copie para .env (o Git ignora) e ajuste. NUNCA coloque segredos reais aqui.
# Em produção, cadastre as variáveis no painel da plataforma (veja DEPLOY.md).

PINGHUB_ENV=development

# --- PostgreSQL ------------------------------------------------------------
# Use DATABASE_URL OU as variáveis DB_* individualmente.
DATABASE_URL=postgresql://postgres:pinghub-local-only@127.0.0.1:5432/pinghub
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=pinghub-local-only
# DB_NAME=pinghub

# --- Administração (obrigatórias em produção) ------------------------------
# Gere cada valor com: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_PASSWORD=replace-with-a-strong-password
SECRET_KEY=replace-with-a-random-secret
ADMIN_TOKEN_HOURS=12
ADMIN_LOGIN_WINDOW=900
ADMIN_LOGIN_MAX=5

# --- Servidor / plataforma -------------------------------------------------
# PORT é injetada pela plataforma em produção (local: 5000).
# PORT=5000
# HOST=127.0.0.1
# TRUSTED_PROXY_COUNT=1
# DB_AUTO_INIT=0
# FLASK_DEBUG=1
# LOG_LEVEL=INFO
