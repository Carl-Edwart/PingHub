# Modelo de configuração do PingHub. Copie para .env (que o Git ignora) e ajuste. NUNCA coloque segredos reais aqui.
# Em produção (Railway etc.) NÃO use arquivo .env: cadastre estas variáveis no painel da plataforma (veja DEPLOY.md).

# --- Ambiente -------------------------------------------------------------
# development = libera os padrões locais (MySQL em 127.0.0.1, usuário root). Qualquer outro valor/ausente = produção estrita.
PINGHUB_ENV=development

# --- Banco de dados (MySQL 8+ ou MariaDB 10.4+) ---------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
# XAMPP local: DB_USER=root com DB_PASSWORD vazio funciona SOMENTE com PINGHUB_ENV=development.
DB_USER=pinghub_app
DB_PASSWORD=defina-a-senha-do-usuario-do-banco
DB_NAME=pinghub
# Opcional: TLS com o banco remoto. DB_SSL=true usa as CAs do sistema; DB_SSL_CA=/caminho/ca.pem usa uma CA específica.
# DB_SSL=true
# DB_SSL_CA=

# --- Administração (obrigatórias; em produção: SECRET_KEY >= 32 caracteres e ADMIN_PASSWORD >= 12) -------------
# Gere cada valor com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_PASSWORD=troque-por-uma-senha-forte
SECRET_KEY=troque-por-um-segredo-aleatorio
ADMIN_TOKEN_HOURS=12
ADMIN_LOGIN_WINDOW=900
ADMIN_LOGIN_MAX=5

# --- Servidor / plataforma --------------------------------------------------
# PORT é injetada pela plataforma em produção (local: 5000). HOST=0.0.0.0 só se quiser acessar pela rede local.
# PORT=5000
# HOST=127.0.0.1
# Quantos proxies reversos confiáveis existem na frente do app (Railway: 1). Faz o limite de login usar o IP real.
# Com 0 (padrão) o cabeçalho X-Forwarded-For é ignorado.
# TRUSTED_PROXY_COUNT=1
# 1 = cria/atualiza tabelas na primeira requisição (padrão em desenvolvimento). Em produção prefira `python app.py init-db`.
# DB_AUTO_INIT=0
# FLASK_DEBUG=1   # só desenvolvimento (run.sh já ativa)
# LOG_LEVEL=INFO
