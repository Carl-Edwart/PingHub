# Modelo de configuração do PingHub.
# Copie para .env (o Git ignora) e ajuste. NUNCA coloque segredos reais aqui.
# Em produção, cadastre as variáveis no painel da plataforma (veja DEPLOY.md).

PINGHUB_ENV=development

# --- PostgreSQL ------------------------------------------------------------
# Use DATABASE_URL OU as variáveis DB_* individualmente.
DATABASE_URL=postgresql://postgres:pinghub-local-only@127.0.0.1:5432/pinghub
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=pinghub-local-only
# DB_NAME=pinghub
# Schema das tabelas (padrão: public). Defina apenas se os dados já estiverem
# em outro schema; a aplicação aborta em vez de duplicar tabelas vazias.
# DB_SCHEMA=public

# --- Administração ---------------------------------------------------------
# ADMIN_PASSWORD é usada só no primeiro boot, quando ainda não há senha no banco:
# ela vira hash scrypt em admin_credentials e depois pode ser removida do ambiente.
# Para trocar a senha, use Admin > Trocar senha (mínimo de 12 caracteres).
# Gere SECRET_KEY com: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_PASSWORD=replace-with-a-strong-password
SECRET_KEY=replace-with-a-random-secret
ADMIN_TOKEN_HOURS=12
ADMIN_LOGIN_WINDOW=900
ADMIN_LOGIN_MAX=5

# --- Servidor / plataforma -------------------------------------------------
# PORT é injetada pela plataforma em produção (local: 5000).
# PORT=5000
# HOST=127.0.0.1
# TRUSTED_PROXY_COUNT=1
# Aplica/atualiza o schema no boot (recomendado; idempotente e sem apagar dados).
# DB_INIT_ON_START=1
# Fallback legado: com DB_INIT_ON_START=0, inicializa na 1ª chamada /api.
# DB_AUTO_INIT=0
# FLASK_DEBUG=1
# LOG_LEVEL=INFO
